      <Placemark><name>霍比屯 / Matamata</name><styleUrl>#current</styleUrl><Point><coordinates>175.682,-37.871,0</coordinates></Point></Placemark>
      <Placemark><name>罗托鲁瓦</name><styleUrl>#current</styleUrl><description><![CDATA[丛林飞跃、Wai-O-Tapu、Te Puia、Mount Tarawera、Waimangu、北岛3日游]]></description><Point><coordinates>176.2497,-38.1368,0</coordinates></Point></Placemark>
      <Placemark><name>陶波 Taupō｜北岛3日游已覆盖</name><styleUrl>#current</styleUrl><description><![CDATA[北岛3日游已覆盖陶波湖区；下一步可拆出火山谷、胡卡瀑布、温泉与湖区轻户外独立 SKU]]></description><Point><coordinates>176.084,-38.6857,0</coordinates></Point></Placemark>
      <Placemark><name>蒂卡波</name><styleUrl>#current</styleUrl><Point><coordinates>170.478,-44.004,0</coordinates></Point></Placemark>
      <Placemark><name>库克山</name><styleUrl>#current</styleUrl><Point><coordinates>170.096,-43.734,0</coordinates></Point></Placemark>
      <Placemark><name>瓦纳卡 / Rob Roy / Mou Waho / Cardrona</name><styleUrl>#current</styleUrl><description><![CDATA[Rob Roy 悬冰川、Mou Waho 湖心岛、Cardrona 射击、生态探索]]></description><Point><coordinates>169.13,-44.70,0</coordinates></Point></Placemark>
      <Placemark><name>皇后镇</name><styleUrl>#current</styleUrl><description><![CDATA[Heliworks Queenstown、复古一日游、米佛峡湾舒享/包车]]></description><Point><coordinates>168.6626,-45.0312,0</coordinates></Point></Placemark>
